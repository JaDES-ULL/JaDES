@prefix : <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix osdi: <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/OSDi/examples/evans1997-migraine> .

<https://w3id.org/ontologies-ULL/OSDi/examples/evans1997-migraine> rdf:type owl:Ontology ;
    owl:versionIRI <https://w3id.org/ontologies-ULL/OSDi/1.3/examples/evans1997-migraine> ;
    owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.3> ;
    rdfs:comment "Validation example of OSDi: Evans KW, Boan JA, Evans JL, Shuaib A. Economic evaluation of oral sumatriptan compared with oral caffeine/ergotamine for migraine. PharmacoEconomics. 1997;12(5):565-577. Decision tree of a migraine attack treated with sumatriptan or caffeine/ergotamine, with rescue at home or in the emergency department and relapse after the relief. See README.md."@en ;
    rdfs:label "OSDi validation example: Evans et al. (1997), sumatriptan versus caffeine/ergotamine for migraine"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#EVANS_BaseUtility
osdi:EVANS_BaseUtility rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "false"^^xsd:boolean ;
    osdi:hasDescription "Base utility of the patients of Evans et al. (1997)" ;
    osdi:hasExpectedValue "1.0"^^xsd:double ;
    osdi:isDisutility "false"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Population
osdi:EVANS_Population rdf:type owl:NamedIndividual ,
        osdi:Population ;
    osdi:hasEpidemiologicalParameter osdi:Constant_Prevalence1 ;
    osdi:hasUtility osdi:EVANS_BaseUtility ;
    osdi:hasDescription "Patients with a migraine attack (Evans et al., 1997). Age and sex are not declared: they do not affect the results" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartmentCost
osdi:EVANS_EmergencyDepartmentCost rdf:type owl:NamedIndividual ,
        osdi:Cost ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:Currency_CanadianDollar ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "Cost of a visit to the emergency department (CAD of 1997)" ;
    osdi:hasExpectedValue "63.16"^^xsd:double ;
    osdi:hasYear "1997"^^xsd:short ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_HospitalizationCost
osdi:EVANS_HospitalizationCost rdf:type owl:NamedIndividual ,
        osdi:Cost ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:Currency_CanadianDollar ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "Cost of the hospitalization after the failure of the emergency department (CAD of 1997)" ;
    osdi:hasExpectedValue "1093.0"^^xsd:double ;
    osdi:hasYear "1997"^^xsd:short ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Hospitalization
osdi:EVANS_Hospitalization rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_HospitalizationCost ;
    osdi:hasDescription "Hospitalization, without a QALY loss of its own" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment_NoReliefRisk
osdi:EVANS_EmergencyDepartment_NoReliefRisk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:hasDescription "Probability that the emergency department does not relieve the attack" ;
    osdi:hasExpectedValue "0.002"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment_NoRelief
osdi:EVANS_EmergencyDepartment_NoRelief rdf:type owl:NamedIndividual ,
        osdi:FailureOutcome ;
    osdi:hasOutcomeRisk osdi:EVANS_EmergencyDepartment_NoReliefRisk ;
    osdi:followedByStrategy osdi:EVANS_Hospitalization ;
    osdi:hasDescription "The emergency department does not relieve the attack: hospitalization" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment_ReliefLoss
osdi:EVANS_EmergencyDepartment_ReliefLoss rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "Negative QALY loss of the relief in the emergency department: the relief shortens the day with pain (-0.4/365)" ;
    osdi:hasExpectedValue "-0.0010958904109589042"^^xsd:double ;
    osdi:isDisutility "true"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment_Relief
osdi:EVANS_EmergencyDepartment_Relief rdf:type owl:NamedIndividual ,
        osdi:SuccessOutcome ;
    osdi:resolvesHealthCondition "true"^^xsd:boolean ;
    osdi:hasUtility osdi:EVANS_EmergencyDepartment_ReliefLoss ;
    osdi:hasDescription "Relief in the emergency department. Assumption of Evans et al.: there is no follow-up after it, so there is no relapse" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment_Proportion
osdi:EVANS_EmergencyDepartment_Proportion rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Proportion ;
    osdi:hasDescription "Proportion of the patients without relief who go to the emergency department" ;
    osdi:hasExpectedValue "0.08"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_EmergencyDepartment
osdi:EVANS_EmergencyDepartment rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_EmergencyDepartmentCost ;
    osdi:hasProportionWithinGroup osdi:EVANS_EmergencyDepartment_Proportion ;
    osdi:hasStrategyOutcome osdi:EVANS_EmergencyDepartment_Relief ,
        osdi:EVANS_EmergencyDepartment_NoRelief ;
    osdi:hasDescription "Visit to the emergency department, without a QALY loss of its own" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Home_Proportion
osdi:EVANS_Home_Proportion rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Proportion ;
    osdi:hasDescription "Proportion of the patients without relief who stay at home" ;
    osdi:hasExpectedValue "0.92"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Home
osdi:EVANS_Home rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasProportionWithinGroup osdi:EVANS_Home_Proportion ;
    osdi:hasDescription "The patient stays at home, without cost or QALY loss of its own" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Rescue
osdi:EVANS_Rescue rdf:type owl:NamedIndividual ,
        osdi:Group ;
    osdi:hasGroupItem osdi:EVANS_Home ,
        osdi:EVANS_EmergencyDepartment ;
    osdi:hasDescription "Rescue after the failure of the drug: stay at home or go to the emergency department" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanDoseCost
osdi:EVANS_SumatriptanDoseCost rdf:type owl:NamedIndividual ,
        osdi:Cost ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:Currency_CanadianDollar ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "Cost of a dose of sumatriptan (CAD of 1997)" ;
    osdi:hasExpectedValue "16.1"^^xsd:double ;
    osdi:hasYear "1997"^^xsd:short ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanSecondDose
osdi:EVANS_SumatriptanSecondDose rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_SumatriptanDoseCost ;
    osdi:hasDescription "Another dose of sumatriptan after the relapse. Assumption of Evans et al.: it always relieves the attack (no outcomes); it has no QALY loss of its own. It is another strategy because decision trees reject cycles" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanFollowUp_RelapseRisk
osdi:EVANS_SumatriptanFollowUp_RelapseRisk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:hasDescription "Probability of relapse after the relief with sumatriptan, among the patients who responded" ;
    osdi:hasExpectedValue "0.406"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanFollowUp_RelapseLoss
osdi:EVANS_SumatriptanFollowUp_RelapseLoss rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "QALY loss of the relapse (0.1/365)" ;
    osdi:hasExpectedValue "0.00027397260273972606"^^xsd:double ;
    osdi:isDisutility "true"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanFollowUp_Relapse
osdi:EVANS_SumatriptanFollowUp_Relapse rdf:type owl:NamedIndividual ,
        osdi:FailureOutcome ;
    osdi:hasOutcomeRisk osdi:EVANS_SumatriptanFollowUp_RelapseRisk ;
    osdi:hasUtility osdi:EVANS_SumatriptanFollowUp_RelapseLoss ;
    osdi:followedByStrategy osdi:EVANS_SumatriptanSecondDose ;
    osdi:hasDescription "Relapse after the relief with sumatriptan: another dose" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanFollowUp_NoRelapse
osdi:EVANS_SumatriptanFollowUp_NoRelapse rdf:type owl:NamedIndividual ,
        osdi:SuccessOutcome ;
    osdi:hasDescription "No relapse after the relief with sumatriptan" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanFollowUp
osdi:EVANS_SumatriptanFollowUp rdf:type owl:NamedIndividual ,
        osdi:FollowUpStrategy ;
    osdi:hasCategory osdi:FollowUpCat ;
    osdi:hasStrategyOutcome osdi:EVANS_SumatriptanFollowUp_Relapse ,
        osdi:EVANS_SumatriptanFollowUp_NoRelapse ;
    osdi:hasDescription "Follow-up after the relief with sumatriptan, without cost: its failure is the relapse (phase 10)" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Sumatriptan_NoReliefRisk
osdi:EVANS_Sumatriptan_NoReliefRisk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:hasDescription "Probability that sumatriptan does not relieve the attack" ;
    osdi:hasExpectedValue "0.442"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Sumatriptan_NoReliefLoss
osdi:EVANS_Sumatriptan_NoReliefLoss rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "QALY loss of the attack that persists after sumatriptan (1.3/365)" ;
    osdi:hasExpectedValue "0.0035616438356164386"^^xsd:double ;
    osdi:isDisutility "true"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Sumatriptan_NoRelief
osdi:EVANS_Sumatriptan_NoRelief rdf:type owl:NamedIndividual ,
        osdi:FailureOutcome ;
    osdi:hasOutcomeRisk osdi:EVANS_Sumatriptan_NoReliefRisk ;
    osdi:hasUtility osdi:EVANS_Sumatriptan_NoReliefLoss ;
    osdi:followedByStrategy osdi:EVANS_Rescue ;
    osdi:hasDescription "sumatriptan does not relieve the attack: rescue" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Sumatriptan_Relief
osdi:EVANS_Sumatriptan_Relief rdf:type owl:NamedIndividual ,
        osdi:SuccessOutcome ;
    osdi:resolvesHealthCondition "true"^^xsd:boolean ;
    osdi:followedByStrategy osdi:EVANS_SumatriptanFollowUp ;
    osdi:hasDescription "sumatriptan relieves the attack, followed by the follow-up of the relapse" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Sumatriptan
osdi:EVANS_Sumatriptan rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_SumatriptanDoseCost ;
    osdi:hasStrategyOutcome osdi:EVANS_Sumatriptan_Relief ,
        osdi:EVANS_Sumatriptan_NoRelief ;
    osdi:hasDescription "Treatment of the attack with sumatriptan" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_SumatriptanReplacement
osdi:EVANS_SumatriptanReplacement rdf:type owl:NamedIndividual ,
        osdi:StrategyReplacementEffect ;
    osdi:affects osdi:EVANS_Attack ;
    osdi:hasReplacementStrategy osdi:EVANS_Sumatriptan ;
    osdi:hasDescription "The attack is treated with sumatriptan" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_InterventionSumatriptan
osdi:EVANS_InterventionSumatriptan rdf:type owl:NamedIndividual ,
        osdi:TherapeuticIntervention ;
    osdi:hasEffect osdi:EVANS_SumatriptanReplacement ;
    osdi:isInterventionOf osdi:EVANS_Attack ;
    osdi:hasDescription "Treatment of the migraine attack with sumatriptan" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotDoseCost
osdi:EVANS_CafergotDoseCost rdf:type owl:NamedIndividual ,
        osdi:Cost ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:Currency_CanadianDollar ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "Cost of a dose of caffeine/ergotamine (CAD of 1997)" ;
    osdi:hasExpectedValue "1.32"^^xsd:double ;
    osdi:hasYear "1997"^^xsd:short ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotSecondDose
osdi:EVANS_CafergotSecondDose rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_CafergotDoseCost ;
    osdi:hasDescription "Another dose of caffeine/ergotamine after the relapse. Assumption of Evans et al.: it always relieves the attack (no outcomes); it has no QALY loss of its own. It is another strategy because decision trees reject cycles" ;
    osdi:includedByModel osdi:EVANS_Model .


