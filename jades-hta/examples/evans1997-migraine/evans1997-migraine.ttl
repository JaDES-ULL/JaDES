osdi:EVANS_CafergotFollowUp_RelapseRisk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:hasDescription "Probability of relapse after the relief with caffeine/ergotamine, among the patients who responded" ;
    osdi:hasExpectedValue "0.297"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotFollowUp_RelapseLoss
osdi:EVANS_CafergotFollowUp_RelapseLoss rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "QALY loss of the relapse (0.1/365)" ;
    osdi:hasExpectedValue "0.00027397260273972606"^^xsd:double ;
    osdi:isDisutility "true"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotFollowUp_Relapse
osdi:EVANS_CafergotFollowUp_Relapse rdf:type owl:NamedIndividual ,
        osdi:FailureOutcome ;
    osdi:hasOutcomeRisk osdi:EVANS_CafergotFollowUp_RelapseRisk ;
    osdi:hasUtility osdi:EVANS_CafergotFollowUp_RelapseLoss ;
    osdi:followedByStrategy osdi:EVANS_CafergotSecondDose ;
    osdi:hasDescription "Relapse after the relief with caffeine/ergotamine: another dose" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotFollowUp_NoRelapse
osdi:EVANS_CafergotFollowUp_NoRelapse rdf:type owl:NamedIndividual ,
        osdi:SuccessOutcome ;
    osdi:hasDescription "No relapse after the relief with caffeine/ergotamine" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotFollowUp
osdi:EVANS_CafergotFollowUp rdf:type owl:NamedIndividual ,
        osdi:FollowUpStrategy ;
    osdi:hasCategory osdi:FollowUpCat ;
    osdi:hasStrategyOutcome osdi:EVANS_CafergotFollowUp_Relapse ,
        osdi:EVANS_CafergotFollowUp_NoRelapse ;
    osdi:hasDescription "Follow-up after the relief with caffeine/ergotamine, without cost: its failure is the relapse (phase 10)" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Cafergot_NoReliefRisk
osdi:EVANS_Cafergot_NoReliefRisk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:hasDescription "Probability that caffeine/ergotamine does not relieve the attack" ;
    osdi:hasExpectedValue "0.621"^^xsd:double ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Cafergot_NoReliefLoss
osdi:EVANS_Cafergot_NoReliefLoss rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ,
        osdi:Utility ;
    osdi:hasDataItemType osdi:DI_Generic_Utility ;
    osdi:appliesOneTime "true"^^xsd:boolean ;
    osdi:hasDescription "QALY loss of the attack that persists after caffeine/ergotamine (1.3/365)" ;
    osdi:hasExpectedValue "0.0035616438356164386"^^xsd:double ;
    osdi:isDisutility "true"^^xsd:boolean ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Cafergot_NoRelief
osdi:EVANS_Cafergot_NoRelief rdf:type owl:NamedIndividual ,
        osdi:FailureOutcome ;
    osdi:hasOutcomeRisk osdi:EVANS_Cafergot_NoReliefRisk ;
    osdi:hasUtility osdi:EVANS_Cafergot_NoReliefLoss ;
    osdi:followedByStrategy osdi:EVANS_Rescue ;
    osdi:hasDescription "caffeine/ergotamine does not relieve the attack: rescue" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Cafergot_Relief
osdi:EVANS_Cafergot_Relief rdf:type owl:NamedIndividual ,
        osdi:SuccessOutcome ;
    osdi:resolvesHealthCondition "true"^^xsd:boolean ;
    osdi:followedByStrategy osdi:EVANS_CafergotFollowUp ;
    osdi:hasDescription "caffeine/ergotamine relieves the attack, followed by the follow-up of the relapse" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Cafergot
osdi:EVANS_Cafergot rdf:type owl:NamedIndividual ,
        osdi:LineOfTherapy ;
    osdi:hasCategory osdi:TreatmentCat ;
    osdi:hasCost osdi:EVANS_CafergotDoseCost ;
    osdi:hasStrategyOutcome osdi:EVANS_Cafergot_Relief ,
        osdi:EVANS_Cafergot_NoRelief ;
    osdi:hasDescription "Treatment of the attack with caffeine/ergotamine" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_CafergotReplacement
osdi:EVANS_CafergotReplacement rdf:type owl:NamedIndividual ,
        osdi:StrategyReplacementEffect ;
    osdi:affects osdi:EVANS_Attack ;
    osdi:hasReplacementStrategy osdi:EVANS_Cafergot ;
    osdi:hasDescription "The attack is treated with caffeine/ergotamine" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_InterventionCafergot
osdi:EVANS_InterventionCafergot rdf:type owl:NamedIndividual ,
        osdi:TherapeuticIntervention ;
    osdi:hasEffect osdi:EVANS_CafergotReplacement ;
    osdi:isInterventionOf osdi:EVANS_Attack ;
    osdi:hasDescription "Treatment of the migraine attack with caffeine/ergotamine" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Attack
osdi:EVANS_Attack rdf:type owl:NamedIndividual ,
        osdi:AcuteManifestation ;
    osdi:hasDescription "Migraine attack: target of both interventions, so the tree starts with it" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Migraine
osdi:EVANS_Migraine rdf:type owl:NamedIndividual ,
        osdi:Disease ;
    osdi:hasProgressionElement osdi:EVANS_Attack ;
    osdi:hasDescription "Migraine" ;
    osdi:includedByModel osdi:EVANS_Model .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Experiment
osdi:EVANS_Experiment rdf:type owl:NamedIndividual ,
        osdi:Experiment ;
    osdi:usesModel osdi:EVANS_Model ;
    osdi:hasDescription "Evans et al. (1997): sumatriptan versus caffeine/ergotamine for a migraine attack, with rescue at home or in the emergency department and relapse after the relief." ;
    osdi:hasDiscountForCosts "0.0"^^xsd:double ;
    osdi:hasDiscountForEffects "0.0"^^xsd:double ;
    osdi:hasDisutilityCombinationMethod "ADD" ;
    osdi:hasTimeHorizon "0.0027397260273972603"^^xsd:double ;
    osdi:hasYear "1997"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#EVANS_Model
osdi:EVANS_Model rdf:type owl:NamedIndividual ,
        osdi:DecisionTreeModel ;
    osdi:hasAssessedIntervention osdi:EVANS_InterventionSumatriptan ;
    osdi:hasComparatorIntervention osdi:EVANS_InterventionCafergot ;
    osdi:includesModelItem 
        osdi:EVANS_BaseUtility ,
        osdi:EVANS_Population ,
        osdi:EVANS_EmergencyDepartmentCost ,
        osdi:EVANS_HospitalizationCost ,
        osdi:EVANS_Hospitalization ,
        osdi:EVANS_EmergencyDepartment_NoReliefRisk ,
        osdi:EVANS_EmergencyDepartment_NoRelief ,
        osdi:EVANS_EmergencyDepartment_ReliefLoss ,
        osdi:EVANS_EmergencyDepartment_Relief ,
        osdi:EVANS_EmergencyDepartment_Proportion ,
        osdi:EVANS_EmergencyDepartment ,
        osdi:EVANS_Home_Proportion ,
        osdi:EVANS_Home ,
        osdi:EVANS_Rescue ,
