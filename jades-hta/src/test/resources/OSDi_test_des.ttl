###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManX_EffectMagnitude
osdi:TD_D02_ManX_EffectMagnitude rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_HazardRatio ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Hazard ratio of ManX with the intervention" ;
    osdi:hasExpectedValue "0.5"^^xsd:double .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManY
osdi:TD_D02_ManY rdf:type owl:NamedIndividual ,
        osdi:ChronicManifestation ;
    osdi:hasRiskCharacterization osdi:TD_D02_ManY_Risk ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Chronic manifestation Y" .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManY_Risk
osdi:TD_D02_ManY_Risk rdf:type owl:NamedIndividual ,
        osdi:DeterministicParameter ;
    osdi:hasDataItemType osdi:DI_Probability ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Annual probability of ManY" ;
    osdi:hasExpectedValue "0.3"^^xsd:double .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManY_Effect
osdi:TD_D02_ManY_Effect rdf:type owl:NamedIndividual ,
