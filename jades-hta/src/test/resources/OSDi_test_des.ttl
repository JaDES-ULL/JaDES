    osdi:hasDataItemType osdi:Currency_Euro ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:appliesOneTime "false"^^xsd:boolean ;
    osdi:hasDescription "Annual cost of the disease" ;
    osdi:hasExpectedValue "1000.0"^^xsd:double ;
    osdi:hasYear "2026"^^xsd:short .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_InterventionNone
osdi:TD_D02_InterventionNone rdf:type owl:NamedIndividual ,
        osdi:TherapeuticIntervention ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Comparator: do nothing" .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_InterventionTreat
osdi:TD_D02_InterventionTreat rdf:type owl:NamedIndividual ,
        osdi:TherapeuticIntervention ;
    osdi:hasEffect osdi:TD_D02_ManX_Effect ,
        osdi:TD_D02_ManY_Effect ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Treatment that reduces the risks of ManX and ManY" .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManX
osdi:TD_D02_ManX rdf:type owl:NamedIndividual ,
        osdi:ChronicManifestation ;
    osdi:hasRiskCharacterization osdi:TD_D02_ManX_Risk ;
    osdi:includedByModel osdi:TD_D02_Model ;
    osdi:hasDescription "Chronic manifestation X" .

