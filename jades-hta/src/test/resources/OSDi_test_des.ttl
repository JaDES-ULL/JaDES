    osdi:hasDescription "Annual probability of ManX" ;
    osdi:hasExpectedValue "0.2"^^xsd:double .

###  https://w3id.org/ontologies-ULL/OSDi#TD_D02_ManX_Effect
osdi:TD_D02_ManX_Effect rdf:type owl:NamedIndividual ,
        osdi:Effect ;
    osdi:affects osdi:TD_D02_ManX_Risk ;
    osdi:hasEffectMagnitude osdi:TD_D02_ManX_EffectMagnitude ;
    osdi:includedByModel osdi:TD_D02_Model ;
