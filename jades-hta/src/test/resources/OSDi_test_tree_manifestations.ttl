@prefix : <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix osdi: <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-manifestations> .

<https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-manifestations> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.1> ;
    rdfs:comment "Individuals for OSDi ontology, version 1.1. Small models to test how decision trees are generated for different combinations of manifestations and developments."@en ;
    rdfs:label "OSDi individuals for testing decision trees: manifestations"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#TT_BaseAnnualCost
osdi:TT_BaseAnnualCost rdf:type owl:NamedIndividual ,
                                osdi:Cost ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:Currency_Euro ;
                       osdi:includedByModel osdi:TT_S11_Model ,
                                            osdi:TT_S12_Model ,
                                            osdi:TT_S13_Model ,
                                            osdi:TT_S14_Model ,
                                            osdi:TT_S15_Model ,
                                            osdi:TT_S16_Model ,
                                            osdi:TT_S17_Model ,
                                            osdi:TT_S18_Model ,
                                            osdi:TT_S19_Model ,
                                            osdi:TT_S22_Model ,
                                            osdi:TT_S23_Model ;
                       osdi:appliesOneTime "false"^^xsd:boolean ;
                       osdi:hasDescription "Annual cost of the disease, whatever its progression" ;
                       osdi:hasExpectedValue "1000.0"^^xsd:double ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionNone
osdi:TT_InterventionNone rdf:type owl:NamedIndividual ,
                                  osdi:TherapeuticIntervention ;
                         osdi:includedByModel osdi:TT_S11_Model ,
                                              osdi:TT_S12_Model ,
                                              osdi:TT_S13_Model ,
                                              osdi:TT_S14_Model ,
                                              osdi:TT_S15_Model ,
                                              osdi:TT_S16_Model ,
                                              osdi:TT_S17_Model ,
                                              osdi:TT_S18_Model ,
                                              osdi:TT_S19_Model ,
                                              osdi:TT_S22_Model ,
                                              osdi:TT_S23_Model ;
                         osdi:hasDescription "Comparator: do nothing" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionTreat
osdi:TT_InterventionTreat rdf:type owl:NamedIndividual ,
                                   osdi:TherapeuticIntervention ;
                          osdi:hasCost osdi:TT_TreatAnnualCost ;
                          osdi:includedByModel osdi:TT_S11_Model ,
                                               osdi:TT_S12_Model ,
                                               osdi:TT_S13_Model ,
                                               osdi:TT_S14_Model ,
                                               osdi:TT_S15_Model ,
                                               osdi:TT_S16_Model ,
                                               osdi:TT_S17_Model ,
                                               osdi:TT_S18_Model ,
                                               osdi:TT_S19_Model ,
                                               osdi:TT_S22_Model ,
                                               osdi:TT_S23_Model ;
                          osdi:hasDescription "Assessed intervention: it only adds an annual cost of 100" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_LifeExpectancy
osdi:TT_LifeExpectancy rdf:type owl:NamedIndividual ,
                                osdi:AttributeValueParameter ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                       osdi:includedByModel osdi:TT_S11_Model ,
                                            osdi:TT_S12_Model ,
                                            osdi:TT_S13_Model ,
                                            osdi:TT_S14_Model ,
                                            osdi:TT_S15_Model ,
                                            osdi:TT_S16_Model ,
                                            osdi:TT_S17_Model ,
                                            osdi:TT_S18_Model ,
                                            osdi:TT_S19_Model ,
                                            osdi:TT_S22_Model ,
                                            osdi:TT_S23_Model ;
                       osdi:isValueOfAttribute osdi:Attribute_LifeExpectancy ;
                       osdi:hasExpectedValue "65.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_Population
osdi:TT_Population rdf:type owl:NamedIndividual ,
                            osdi:Population ;
                   osdi:hasAge osdi:TT_PopulationAge ;
                   osdi:hasEpidemiologicalParameter osdi:Constant_Prevalence1 ;
                   osdi:hasLifeExpectancy osdi:TT_LifeExpectancy ;
                   osdi:hasSex osdi:TT_PopulationSex ;
                   osdi:hasUtility osdi:TT_PopulationBaseUtility ;
                   osdi:includedByModel osdi:TT_S11_Model ,
                                        osdi:TT_S12_Model ,
                                        osdi:TT_S13_Model ,
                                        osdi:TT_S14_Model ,
                                        osdi:TT_S15_Model ,
                                        osdi:TT_S16_Model ,
                                        osdi:TT_S17_Model ,
                                        osdi:TT_S18_Model ,
                                        osdi:TT_S19_Model ,
                                        osdi:TT_S22_Model ,
                                        osdi:TT_S23_Model ;
                   osdi:hasDescription "A dummy population of 1000 individuals. Everyone starts at 20 years old, with 65 remaining years of life and a base utility of 0.85" ;
                   osdi:hasGeographicalContext "Spain" ;
                   osdi:hasMaxAge "100.0"^^xsd:double ;
                   osdi:hasMinAge "18.0"^^xsd:double ;
                   osdi:hasSize 1000 .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationAge
osdi:TT_PopulationAge rdf:type owl:NamedIndividual ,
                               osdi:AttributeValueParameter ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Other ;
                      osdi:includedByModel osdi:TT_S11_Model ,
                                           osdi:TT_S12_Model ,
                                           osdi:TT_S13_Model ,
                                           osdi:TT_S14_Model ,
                                           osdi:TT_S15_Model ,
                                           osdi:TT_S16_Model ,
                                           osdi:TT_S17_Model ,
                                           osdi:TT_S18_Model ,
                                           osdi:TT_S19_Model ,
                                           osdi:TT_S22_Model ,
                                           osdi:TT_S23_Model ;
                      osdi:isValueOfAttribute osdi:Attribute_Age ;
                      osdi:hasExpectedValue "20.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationBaseUtility
osdi:TT_PopulationBaseUtility rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ,
                                       osdi:Utility ;
                              osdi:hasDataItemType osdi:DI_Generic_Utility ;
                              osdi:includedByModel osdi:TT_S11_Model ,
                                                   osdi:TT_S12_Model ,
                                                   osdi:TT_S13_Model ,
                                                   osdi:TT_S14_Model ,
                                                   osdi:TT_S15_Model ,
                                                   osdi:TT_S16_Model ,
                                                   osdi:TT_S17_Model ,
                                                   osdi:TT_S18_Model ,
                                                   osdi:TT_S19_Model ,
                                                   osdi:TT_S22_Model ,
                                                   osdi:TT_S23_Model ;
                              osdi:appliesOneTime "false"^^xsd:boolean ;
                              osdi:hasDescription "Base utility for the studied population" ;
                              osdi:hasExpectedValue "0.85"^^xsd:double ;
                              osdi:isDisutility "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationSex
osdi:TT_PopulationSex rdf:type owl:NamedIndividual ,
                               osdi:AttributeValueParameter ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Proportion ;
                      osdi:includedByModel osdi:TT_S11_Model ,
                                           osdi:TT_S12_Model ,
                                           osdi:TT_S13_Model ,
                                           osdi:TT_S14_Model ,
                                           osdi:TT_S15_Model ,
                                           osdi:TT_S16_Model ,
                                           osdi:TT_S17_Model ,
                                           osdi:TT_S18_Model ,
                                           osdi:TT_S19_Model ,
                                           osdi:TT_S22_Model ,
                                           osdi:TT_S23_Model ;
                      osdi:isValueOfAttribute osdi:Attribute_Sex ;
                      osdi:hasExpectedValue "0.5"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_Disease
osdi:TT_S11_Disease rdf:type owl:NamedIndividual ,
                             osdi:Disease ;
                    osdi:hasCost osdi:TT_BaseAnnualCost ;
                    osdi:hasIntervention osdi:TT_InterventionTreat ,
                                         osdi:TT_InterventionNone ;
                    osdi:hasProgressionElement osdi:TT_S11_ManX ,
                                               osdi:TT_S11_ManY ;
                    osdi:includedByModel osdi:TT_S11_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_Experiment
osdi:TT_S11_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_S11_Model ;
                       osdi:hasDescription "Two coexistent manifestations without developments." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManX
osdi:TT_S11_ManX rdf:type owl:NamedIndividual ,
                          osdi:ChronicManifestation ;
                 osdi:hasCost osdi:TT_S11_ManX_Cost ;
                 osdi:hasRiskCharacterization osdi:TT_S11_ManX_Risk ;
                 osdi:hasUtility osdi:TT_S11_ManX_Disutility ;
                 osdi:includedByModel osdi:TT_S11_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManX_Cost
osdi:TT_S11_ManX_Cost rdf:type owl:NamedIndividual ,
                               osdi:Cost ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:Currency_Euro ;
                      osdi:includedByModel osdi:TT_S11_Model ;
                      osdi:appliesOneTime "false"^^xsd:boolean ;
                      osdi:hasDescription "Annual cost of ManX" ;
                      osdi:hasExpectedValue "150.0"^^xsd:double ;
                      osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManX_Disutility
osdi:TT_S11_ManX_Disutility rdf:type owl:NamedIndividual ,
                                     osdi:DeterministicParameter ,
                                     osdi:Utility ;
                            osdi:hasDataItemType osdi:DI_Generic_Utility ;
                            osdi:includedByModel osdi:TT_S11_Model ;
                            osdi:appliesOneTime "false"^^xsd:boolean ;
                            osdi:hasDescription "Annual disutility of ManX" ;
                            osdi:hasExpectedValue "0.03"^^xsd:double ;
                            osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManX_Risk
osdi:TT_S11_ManX_Risk rdf:type owl:NamedIndividual ,
                               osdi:DeterministicParameter ;
