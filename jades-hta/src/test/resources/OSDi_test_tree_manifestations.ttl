                            osdi:hasExpectedValue "0.06"^^xsd:double ;
                            osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY_LER
osdi:TT_S11_ManY_LER rdf:type owl:NamedIndividual ,
                              osdi:LifeExpectancyReductionEffect ;
                     osdi:affects osdi:Attribute_LifeExpectancy ;
                     osdi:hasEffectMagnitude osdi:TT_S11_ManY_LERMagnitude ;
                     osdi:includedByModel osdi:TT_S11_Model ;
                     osdi:hasDescription "Life expectancy reduction due to ManY" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY_LERMagnitude
osdi:TT_S11_ManY_LERMagnitude rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ;
                              osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                              osdi:includedByModel osdi:TT_S11_Model ;
                              osdi:hasDescription "Years of life lost due to ManY" ;
                              osdi:hasExpectedValue "2.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY_Risk
osdi:TT_S11_ManY_Risk rdf:type owl:NamedIndividual ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Incidence ;
                      osdi:includedByModel osdi:TT_S11_Model ;
                      osdi:hasDescription "Probability of ManY" ;
                      osdi:hasExpectedValue "0.5"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_Model
osdi:TT_S11_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_InterventionTreat ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_S11_Disease ,
                                         osdi:TT_S11_ManX ,
                                         osdi:TT_S11_ManX_Cost ,
                                         osdi:TT_S11_ManX_Disutility ,
                                         osdi:TT_S11_ManX_Risk ,
                                         osdi:TT_S11_ManY ,
                                         osdi:TT_S11_ManY_Cost ,
                                         osdi:TT_S11_ManY_Disutility ,
                                         osdi:TT_S11_ManY_LER ,
                                         osdi:TT_S11_ManY_LERMagnitude ,
                                         osdi:TT_S11_ManY_Risk ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "S11. Two coexistent manifestations without developments. Manifestations not linked to any development and not affected by any rule are independent." .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S12_AlternativeMans
osdi:TT_S12_AlternativeMans rdf:type owl:NamedIndividual ,
                                     osdi:AlternativeCombinationRule ;
                            osdi:affectsProgressionElement osdi:TT_S12_ManY ,
                                                           osdi:TT_S12_ManZ ;
                            osdi:includedByModel osdi:TT_S12_Model ;
                            osdi:hasNullProgression "true"^^xsd:boolean .


