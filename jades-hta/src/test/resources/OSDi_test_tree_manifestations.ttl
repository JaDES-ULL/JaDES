                      osdi:includedByModel osdi:TT_S11_Model ;
                      osdi:hasDescription "Probability of ManX" ;
                      osdi:hasExpectedValue "0.2"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY
osdi:TT_S11_ManY rdf:type owl:NamedIndividual ,
                          osdi:ChronicManifestation ;
                 osdi:hasCost osdi:TT_S11_ManY_Cost ;
                 osdi:hasEffect osdi:TT_S11_ManY_LER ;
                 osdi:hasRiskCharacterization osdi:TT_S11_ManY_Risk ;
                 osdi:hasUtility osdi:TT_S11_ManY_Disutility ;
                 osdi:includedByModel osdi:TT_S11_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY_Cost
osdi:TT_S11_ManY_Cost rdf:type owl:NamedIndividual ,
                               osdi:Cost ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:Currency_Euro ;
                      osdi:includedByModel osdi:TT_S11_Model ;
                      osdi:appliesOneTime "false"^^xsd:boolean ;
                      osdi:hasDescription "Annual cost of ManY" ;
                      osdi:hasExpectedValue "250.0"^^xsd:double ;
                      osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S11_ManY_Disutility
osdi:TT_S11_ManY_Disutility rdf:type owl:NamedIndividual ,
                                     osdi:DeterministicParameter ,
                                     osdi:Utility ;
                            osdi:hasDataItemType osdi:DI_Generic_Utility ;
                            osdi:includedByModel osdi:TT_S11_Model ;
