                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "P02. Intervention effect on a risk: difference (-0.3)." .


