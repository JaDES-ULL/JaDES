###  https://w3id.org/ontologies-ULL/OSDi#TT_P03_Model
osdi:TT_P03_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_P03_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
