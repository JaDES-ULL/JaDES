@prefix : <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix osdi: <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-payoffs> .

<https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-payoffs> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.1> ;
    rdfs:comment "Individuals for OSDi ontology, version 1.1. Small models to test how costs, utilities, life expectancy and intervention effects are computed in decision trees. Each model tests one feature."@en ;
    rdfs:label "OSDi individuals for testing decision trees: costs, utilities and effects"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#TT_BaseAnnualCost
osdi:TT_BaseAnnualCost rdf:type owl:NamedIndividual ,
                                osdi:Cost ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:Currency_Euro ;
                       osdi:includedByModel osdi:TT_P01_Model ,
                                            osdi:TT_P02_Model ,
                                            osdi:TT_P03_Model ,
                                            osdi:TT_P04_Model ,
                                            osdi:TT_P05_Model ,
                                            osdi:TT_P06_Model ,
                                            osdi:TT_P07_Model ,
                                            osdi:TT_P08_Model ,
                                            osdi:TT_P09_Model ,
                                            osdi:TT_P10_Model ,
                                            osdi:TT_P11_Model ,
                                            osdi:TT_P12_Model ,
                                            osdi:TT_P13_Model ,
                                            osdi:TT_P14_Model ,
                                            osdi:TT_P15_Model ,
                                            osdi:TT_P16_Model ,
                                            osdi:TT_P17_Model ,
                                            osdi:TT_P18_Model ,
                                            osdi:TT_P19_Model ,
                                            osdi:TT_P20_Model ,
                                            osdi:TT_P21_Model ;
                       osdi:appliesOneTime "false"^^xsd:boolean ;
                       osdi:hasDescription "Annual cost of the disease, whatever its progression" ;
                       osdi:hasExpectedValue "1000.0"^^xsd:double ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionNone
osdi:TT_InterventionNone rdf:type owl:NamedIndividual ,
                                  osdi:TherapeuticIntervention ;
                         osdi:includedByModel osdi:TT_P01_Model ,
                                              osdi:TT_P02_Model ,
                                              osdi:TT_P03_Model ,
                                              osdi:TT_P04_Model ,
                                              osdi:TT_P05_Model ,
                                              osdi:TT_P06_Model ,
                                              osdi:TT_P07_Model ,
                                              osdi:TT_P08_Model ,
                                              osdi:TT_P09_Model ,
                                              osdi:TT_P10_Model ,
                                              osdi:TT_P11_Model ,
                                              osdi:TT_P12_Model ,
                                              osdi:TT_P13_Model ,
                                              osdi:TT_P14_Model ,
                                              osdi:TT_P15_Model ,
                                              osdi:TT_P16_Model ,
                                              osdi:TT_P17_Model ,
                                              osdi:TT_P18_Model ,
                                              osdi:TT_P19_Model ,
                                              osdi:TT_P20_Model ,
                                              osdi:TT_P21_Model ;
                         osdi:hasDescription "Comparator: do nothing" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionTreat
osdi:TT_InterventionTreat rdf:type owl:NamedIndividual ,
                                   osdi:TherapeuticIntervention ;
                          osdi:hasCost osdi:TT_TreatAnnualCost ;
                          osdi:includedByModel osdi:TT_P10_Model ,
                                               osdi:TT_P11_Model ,
                                               osdi:TT_P12_Model ,
                                               osdi:TT_P14_Model ,
                                               osdi:TT_P15_Model ,
                                               osdi:TT_P16_Model ,
                                               osdi:TT_P17_Model ,
                                               osdi:TT_P18_Model ,
                                               osdi:TT_P19_Model ,
                                               osdi:TT_P20_Model ,
                                               osdi:TT_P21_Model ;
                          osdi:hasDescription "Assessed intervention: it only adds an annual cost of 100" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_LifeExpectancy
osdi:TT_LifeExpectancy rdf:type owl:NamedIndividual ,
                                osdi:AttributeValueParameter ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                       osdi:includedByModel osdi:TT_P01_Model ,
                                            osdi:TT_P02_Model ,
                                            osdi:TT_P03_Model ,
                                            osdi:TT_P04_Model ,
                                            osdi:TT_P05_Model ,
                                            osdi:TT_P06_Model ,
                                            osdi:TT_P07_Model ,
                                            osdi:TT_P08_Model ,
                                            osdi:TT_P09_Model ,
                                            osdi:TT_P10_Model ,
                                            osdi:TT_P11_Model ,
                                            osdi:TT_P12_Model ,
                                            osdi:TT_P13_Model ,
                                            osdi:TT_P14_Model ,
                                            osdi:TT_P15_Model ,
                                            osdi:TT_P16_Model ,
                                            osdi:TT_P20_Model ;
                       osdi:isValueOfAttribute osdi:Attribute_LifeExpectancy ;
                       osdi:hasExpectedValue "65.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_NewbornLifeExpectancy
osdi:TT_NewbornLifeExpectancy rdf:type owl:NamedIndividual ,
                                       osdi:AttributeValueParameter ,
                                       osdi:DeterministicParameter ;
                              osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                              osdi:includedByModel osdi:TT_P17_Model ,
                                                   osdi:TT_P18_Model ,
                                                   osdi:TT_P19_Model ,
                                                   osdi:TT_P21_Model ;
                              osdi:isValueOfAttribute osdi:Attribute_LifeExpectancy ;
                              osdi:hasExpectedValue "80.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_NewbornPopulation
osdi:TT_NewbornPopulation rdf:type owl:NamedIndividual ,
                                   osdi:Population ;
                          osdi:hasAge osdi:TT_NewbornPopulationAge ;
                          osdi:hasEpidemiologicalParameter osdi:Constant_Prevalence1 ;
                          osdi:hasLifeExpectancy osdi:TT_NewbornLifeExpectancy ;
                          osdi:hasSex osdi:TT_PopulationSex ;
                          osdi:hasUtility osdi:TT_PopulationBaseUtility ;
                          osdi:includedByModel osdi:TT_P17_Model ,
                                               osdi:TT_P18_Model ,
                                               osdi:TT_P19_Model ,
                                               osdi:TT_P21_Model ;
                          osdi:hasDescription "A dummy population of 1000 newborns, with a life expectancy of 80 years and a base utility of 0.85" ;
                          osdi:hasGeographicalContext "Spain" ;
                          osdi:hasMaxAge "100.0"^^xsd:double ;
                          osdi:hasMinAge "0.0"^^xsd:double ;
                          osdi:hasSize 1000 .


###  https://w3id.org/ontologies-ULL/OSDi#TT_NewbornPopulationAge
osdi:TT_NewbornPopulationAge rdf:type owl:NamedIndividual ,
                                      osdi:AttributeValueParameter ,
                                      osdi:DeterministicParameter ;
                             osdi:hasDataItemType osdi:DI_Other ;
                             osdi:includedByModel osdi:TT_P17_Model ,
                                                  osdi:TT_P18_Model ,
                                                  osdi:TT_P19_Model ,
                                                  osdi:TT_P21_Model ;
                             osdi:isValueOfAttribute osdi:Attribute_Age ;
                             osdi:hasExpectedValue "0.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Developments
osdi:TT_P01_Developments rdf:type owl:NamedIndividual ,
                                  osdi:AlternativeCombinationRule ;
                         osdi:affectsProgressionElement osdi:TT_P01_Severe ,
                                                        osdi:TT_P01_Normal ;
                         osdi:includedByModel osdi:TT_P01_Model ;
                         osdi:hasNullProgression "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Disease
osdi:TT_P01_Disease rdf:type owl:NamedIndividual ,
                             osdi:Disease ;
                    osdi:hasCost osdi:TT_BaseAnnualCost ;
                    osdi:hasIntervention osdi:TT_P01_InterventionTreat ,
                                         osdi:TT_InterventionNone ;
                    osdi:hasProgressionElement osdi:TT_P01_Severe ,
                                               osdi:TT_P01_Normal ,
                                               osdi:TT_P01_Developments ;
                    osdi:includedByModel osdi:TT_P01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Experiment
osdi:TT_P01_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_P01_Model ;
                       osdi:hasDescription "Intervention effect on a risk: relative risk (x0.5)." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_InterventionTreat
osdi:TT_P01_InterventionTreat rdf:type owl:NamedIndividual ,
                                       osdi:TherapeuticIntervention ;
                              osdi:hasCost osdi:TT_TreatAnnualCost ;
                              osdi:hasEffect osdi:TT_P01_TreatEffect ;
                              osdi:includedByModel osdi:TT_P01_Model ;
                              osdi:hasDescription "The intervention halves the incidence of the severe development" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Model
osdi:TT_P01_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_P01_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_P01_Developments ,
                                         osdi:TT_P01_Disease ,
                                         osdi:TT_P01_InterventionTreat ,
                                         osdi:TT_P01_Normal ,
                                         osdi:TT_P01_Severe ,
                                         osdi:TT_P01_Severe_Cost ,
                                         osdi:TT_P01_Severe_Disutility ,
                                         osdi:TT_P01_Severe_LER ,
                                         osdi:TT_P01_Severe_LERMagnitude ,
                                         osdi:TT_P01_Severe_Risk ,
                                         osdi:TT_P01_TreatEffect ,
                                         osdi:TT_P01_TreatEffectMagnitude ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "P01. Intervention effect on a risk: relative risk (x0.5)." .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Normal
osdi:TT_P01_Normal rdf:type owl:NamedIndividual ,
                            osdi:Development ;
                   osdi:includedByModel osdi:TT_P01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe
osdi:TT_P01_Severe rdf:type owl:NamedIndividual ,
                            osdi:Development ;
                   osdi:hasCost osdi:TT_P01_Severe_Cost ;
                   osdi:hasEffect osdi:TT_P01_Severe_LER ;
                   osdi:hasRiskCharacterization osdi:TT_P01_Severe_Risk ;
                   osdi:hasUtility osdi:TT_P01_Severe_Disutility ;
                   osdi:includedByModel osdi:TT_P01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe_Cost
osdi:TT_P01_Severe_Cost rdf:type owl:NamedIndividual ,
                                 osdi:Cost ,
                                 osdi:DeterministicParameter ;
                        osdi:hasDataItemType osdi:Currency_Euro ;
                        osdi:includedByModel osdi:TT_P01_Model ;
                        osdi:appliesOneTime "false"^^xsd:boolean ;
                        osdi:hasDescription "Annual cost of Severe" ;
                        osdi:hasExpectedValue "1000.0"^^xsd:double ;
                        osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe_Disutility
osdi:TT_P01_Severe_Disutility rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ,
                                       osdi:Utility ;
                              osdi:hasDataItemType osdi:DI_Generic_Utility ;
                              osdi:includedByModel osdi:TT_P01_Model ;
                              osdi:appliesOneTime "false"^^xsd:boolean ;
                              osdi:hasDescription "Annual disutility of Severe" ;
                              osdi:hasExpectedValue "0.4"^^xsd:double ;
                              osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe_LER
osdi:TT_P01_Severe_LER rdf:type owl:NamedIndividual ,
                                osdi:LifeExpectancyReductionEffect ;
                       osdi:affects osdi:Attribute_LifeExpectancy ;
                       osdi:hasEffectMagnitude osdi:TT_P01_Severe_LERMagnitude ;
                       osdi:includedByModel osdi:TT_P01_Model ;
                       osdi:hasDescription "Life expectancy reduction due to Severe" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe_LERMagnitude
osdi:TT_P01_Severe_LERMagnitude rdf:type owl:NamedIndividual ,
                                         osdi:DeterministicParameter ;
                                osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                                osdi:includedByModel osdi:TT_P01_Model ;
                                osdi:hasDescription "Years of life lost due to Severe" ;
                                osdi:hasExpectedValue "20.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_Severe_Risk
osdi:TT_P01_Severe_Risk rdf:type owl:NamedIndividual ,
                                 osdi:DeterministicParameter ;
                        osdi:hasDataItemType osdi:DI_Incidence ;
                        osdi:includedByModel osdi:TT_P01_Model ;
                        osdi:hasDescription "Probability of Severe" ;
                        osdi:hasExpectedValue "0.8"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_TreatEffect
osdi:TT_P01_TreatEffect rdf:type owl:NamedIndividual ,
                                 osdi:Effect ;
                        osdi:affects osdi:TT_P01_Severe_Risk ;
                        osdi:hasEffectMagnitude osdi:TT_P01_TreatEffectMagnitude ;
                        osdi:includedByModel osdi:TT_P01_Model ;
                        osdi:hasDescription "The intervention halves the incidence of the severe development" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_P01_TreatEffectMagnitude
osdi:TT_P01_TreatEffectMagnitude rdf:type owl:NamedIndividual ,
                                          osdi:DeterministicParameter ;
                                 osdi:hasDataItemType osdi:DI_RelativeRisk ;
                                 osdi:includedByModel osdi:TT_P01_Model ;
                                 osdi:hasDescription "The intervention halves the incidence of the severe development" ;
                                 osdi:hasExpectedValue "0.5"^^xsd:double .


