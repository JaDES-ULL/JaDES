###  https://w3id.org/ontologies-ULL/OSDi#TT_S03_Experiment
osdi:TT_S03_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_S03_Model ;
                       osdi:hasDescription "Single development without risk (default risk of 1)." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S03_Model
osdi:TT_S03_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_InterventionTreat ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_S03_DevA ,
                                         osdi:TT_S03_DevA_Cost ,
                                         osdi:TT_S03_DevA_Disutility ,
                                         osdi:TT_S03_DevA_LER ,
                                         osdi:TT_S03_DevA_LERMagnitude ,
                                         osdi:TT_S03_Disease ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "S03. Single development without risk (default risk of 1). A development with no risk and no rule is assumed to always appear." .


