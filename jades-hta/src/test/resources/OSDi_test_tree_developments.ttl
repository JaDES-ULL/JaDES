@prefix : <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix osdi: <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-developments> .

<https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-developments> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.1> ;
    rdfs:comment "Individuals for OSDi ontology, version 1.1. Small models to test how decision trees are generated for different combinations of developments. Each model (TT_Sxx_Model) is self-contained and its description states what is being tested."@en ;
    rdfs:label "OSDi individuals for testing decision trees: developments"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#TT_BaseAnnualCost
osdi:TT_BaseAnnualCost rdf:type owl:NamedIndividual ,
                                osdi:Cost ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:Currency_Euro ;
                       osdi:includedByModel osdi:TT_S01_Model ,
                                            osdi:TT_S02_Model ,
                                            osdi:TT_S03_Model ,
                                            osdi:TT_S04_Model ,
                                            osdi:TT_S05_Model ,
                                            osdi:TT_S06_Model ,
                                            osdi:TT_S07_Model ,
                                            osdi:TT_S08_Model ,
                                            osdi:TT_S09_Model ,
                                            osdi:TT_S10_Model ;
                       osdi:appliesOneTime "false"^^xsd:boolean ;
                       osdi:hasDescription "Annual cost of the disease, whatever its progression" ;
                       osdi:hasExpectedValue "1000.0"^^xsd:double ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionNone
osdi:TT_InterventionNone rdf:type owl:NamedIndividual ,
                                  osdi:TherapeuticIntervention ;
                         osdi:includedByModel osdi:TT_S01_Model ,
                                              osdi:TT_S02_Model ,
                                              osdi:TT_S03_Model ,
                                              osdi:TT_S04_Model ,
                                              osdi:TT_S05_Model ,
                                              osdi:TT_S06_Model ,
                                              osdi:TT_S07_Model ,
                                              osdi:TT_S08_Model ,
                                              osdi:TT_S09_Model ,
                                              osdi:TT_S10_Model ;
                         osdi:hasDescription "Comparator: do nothing" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionTreat
osdi:TT_InterventionTreat rdf:type owl:NamedIndividual ,
                                   osdi:TherapeuticIntervention ;
                          osdi:hasCost osdi:TT_TreatAnnualCost ;
                          osdi:includedByModel osdi:TT_S01_Model ,
                                               osdi:TT_S02_Model ,
                                               osdi:TT_S03_Model ,
                                               osdi:TT_S04_Model ,
                                               osdi:TT_S05_Model ,
                                               osdi:TT_S06_Model ,
                                               osdi:TT_S07_Model ,
                                               osdi:TT_S08_Model ,
                                               osdi:TT_S09_Model ,
                                               osdi:TT_S10_Model ;
                          osdi:hasDescription "Assessed intervention: it only adds an annual cost of 100" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_LifeExpectancy
osdi:TT_LifeExpectancy rdf:type owl:NamedIndividual ,
                                osdi:AttributeValueParameter ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                       osdi:includedByModel osdi:TT_S01_Model ,
                                            osdi:TT_S02_Model ,
                                            osdi:TT_S03_Model ,
                                            osdi:TT_S04_Model ,
                                            osdi:TT_S05_Model ,
                                            osdi:TT_S06_Model ,
                                            osdi:TT_S07_Model ,
                                            osdi:TT_S08_Model ,
                                            osdi:TT_S09_Model ,
                                            osdi:TT_S10_Model ;
                       osdi:isValueOfAttribute osdi:Attribute_LifeExpectancy ;
                       osdi:hasExpectedValue "65.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_Population
osdi:TT_Population rdf:type owl:NamedIndividual ,
                            osdi:Population ;
                   osdi:hasAge osdi:TT_PopulationAge ;
                   osdi:hasEpidemiologicalParameter osdi:Constant_Prevalence1 ;
                   osdi:hasLifeExpectancy osdi:TT_LifeExpectancy ;
                   osdi:hasSex osdi:TT_PopulationSex ;
                   osdi:hasUtility osdi:TT_PopulationBaseUtility ;
                   osdi:includedByModel osdi:TT_S01_Model ,
                                        osdi:TT_S02_Model ,
                                        osdi:TT_S03_Model ,
                                        osdi:TT_S04_Model ,
                                        osdi:TT_S05_Model ,
                                        osdi:TT_S06_Model ,
                                        osdi:TT_S07_Model ,
                                        osdi:TT_S08_Model ,
                                        osdi:TT_S09_Model ,
                                        osdi:TT_S10_Model ;
                   osdi:hasDescription "A dummy population of 1000 individuals. Everyone starts at 20 years old, with 65 remaining years of life and a base utility of 0.85" ;
                   osdi:hasGeographicalContext "Spain" ;
                   osdi:hasMaxAge "100.0"^^xsd:double ;
                   osdi:hasMinAge "18.0"^^xsd:double ;
                   osdi:hasSize 1000 .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationAge
osdi:TT_PopulationAge rdf:type owl:NamedIndividual ,
                               osdi:AttributeValueParameter ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Other ;
                      osdi:includedByModel osdi:TT_S01_Model ,
                                           osdi:TT_S02_Model ,
                                           osdi:TT_S03_Model ,
                                           osdi:TT_S04_Model ,
                                           osdi:TT_S05_Model ,
                                           osdi:TT_S06_Model ,
                                           osdi:TT_S07_Model ,
                                           osdi:TT_S08_Model ,
                                           osdi:TT_S09_Model ,
                                           osdi:TT_S10_Model ;
                      osdi:isValueOfAttribute osdi:Attribute_Age ;
                      osdi:hasExpectedValue "20.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationBaseUtility
osdi:TT_PopulationBaseUtility rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ,
                                       osdi:Utility ;
                              osdi:hasDataItemType osdi:DI_Generic_Utility ;
                              osdi:includedByModel osdi:TT_S01_Model ,
                                                   osdi:TT_S02_Model ,
                                                   osdi:TT_S03_Model ,
                                                   osdi:TT_S04_Model ,
                                                   osdi:TT_S05_Model ,
                                                   osdi:TT_S06_Model ,
                                                   osdi:TT_S07_Model ,
                                                   osdi:TT_S08_Model ,
                                                   osdi:TT_S09_Model ,
                                                   osdi:TT_S10_Model ;
                              osdi:appliesOneTime "false"^^xsd:boolean ;
                              osdi:hasDescription "Base utility for the studied population" ;
                              osdi:hasExpectedValue "0.85"^^xsd:double ;
                              osdi:isDisutility "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_PopulationSex
osdi:TT_PopulationSex rdf:type owl:NamedIndividual ,
                               osdi:AttributeValueParameter ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Proportion ;
                      osdi:includedByModel osdi:TT_S01_Model ,
                                           osdi:TT_S02_Model ,
                                           osdi:TT_S03_Model ,
                                           osdi:TT_S04_Model ,
                                           osdi:TT_S05_Model ,
                                           osdi:TT_S06_Model ,
                                           osdi:TT_S07_Model ,
                                           osdi:TT_S08_Model ,
                                           osdi:TT_S09_Model ,
                                           osdi:TT_S10_Model ;
                      osdi:isValueOfAttribute osdi:Attribute_Sex ;
                      osdi:hasExpectedValue "0.5"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S01_Disease
osdi:TT_S01_Disease rdf:type owl:NamedIndividual ,
                             osdi:Disease ;
                    osdi:hasCost osdi:TT_BaseAnnualCost ;
                    osdi:hasIntervention osdi:TT_InterventionTreat ,
                                         osdi:TT_InterventionNone ;
                    osdi:includedByModel osdi:TT_S01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S01_Experiment
osdi:TT_S01_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_S01_Model ;
                       osdi:hasDescription "No progression: each arm is a single payoff." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S01_Model
osdi:TT_S01_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_InterventionTreat ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_S01_Disease ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "S01. No progression: each arm is a single payoff. The disease defines neither developments nor manifestations." .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA
osdi:TT_S02_DevA rdf:type owl:NamedIndividual ,
                          osdi:Development ;
                 osdi:hasCost osdi:TT_S02_DevA_Cost ;
                 osdi:hasEffect osdi:TT_S02_DevA_LER ;
                 osdi:hasRiskCharacterization osdi:TT_S02_DevA_Risk ;
                 osdi:hasUtility osdi:TT_S02_DevA_Disutility ;
                 osdi:includedByModel osdi:TT_S02_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA_Cost
osdi:TT_S02_DevA_Cost rdf:type owl:NamedIndividual ,
                               osdi:Cost ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:Currency_Euro ;
                      osdi:includedByModel osdi:TT_S02_Model ;
                      osdi:appliesOneTime "false"^^xsd:boolean ;
                      osdi:hasDescription "Annual cost of DevA" ;
                      osdi:hasExpectedValue "500.0"^^xsd:double ;
                      osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA_Disutility
osdi:TT_S02_DevA_Disutility rdf:type owl:NamedIndividual ,
                                     osdi:DeterministicParameter ,
                                     osdi:Utility ;
                            osdi:hasDataItemType osdi:DI_Generic_Utility ;
                            osdi:includedByModel osdi:TT_S02_Model ;
                            osdi:appliesOneTime "false"^^xsd:boolean ;
                            osdi:hasDescription "Annual disutility of DevA" ;
                            osdi:hasExpectedValue "0.1"^^xsd:double ;
                            osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA_LER
osdi:TT_S02_DevA_LER rdf:type owl:NamedIndividual ,
                              osdi:LifeExpectancyReductionEffect ;
                     osdi:affects osdi:Attribute_LifeExpectancy ;
                     osdi:hasEffectMagnitude osdi:TT_S02_DevA_LERMagnitude ;
                     osdi:includedByModel osdi:TT_S02_Model ;
                     osdi:hasDescription "Life expectancy reduction due to DevA" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA_LERMagnitude
osdi:TT_S02_DevA_LERMagnitude rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ;
                              osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                              osdi:includedByModel osdi:TT_S02_Model ;
                              osdi:hasDescription "Years of life lost due to DevA" ;
                              osdi:hasExpectedValue "10.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_DevA_Risk
osdi:TT_S02_DevA_Risk rdf:type owl:NamedIndividual ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:DI_Incidence ;
                      osdi:includedByModel osdi:TT_S02_Model ;
                      osdi:hasDescription "Probability of DevA" ;
                      osdi:hasExpectedValue "0.3"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_Disease
osdi:TT_S02_Disease rdf:type owl:NamedIndividual ,
                             osdi:Disease ;
                    osdi:hasCost osdi:TT_BaseAnnualCost ;
                    osdi:hasIntervention osdi:TT_InterventionTreat ,
                                         osdi:TT_InterventionNone ;
                    osdi:hasProgressionElement osdi:TT_S02_DevA ;
                    osdi:includedByModel osdi:TT_S02_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_Experiment
osdi:TT_S02_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_S02_Model ;
                       osdi:hasDescription "Single development with risk." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_S02_Model
osdi:TT_S02_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_InterventionTreat ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_S02_DevA ,
                                         osdi:TT_S02_DevA_Cost ,
                                         osdi:TT_S02_DevA_Disutility ,
                                         osdi:TT_S02_DevA_LER ,
                                         osdi:TT_S02_DevA_LERMagnitude ,
                                         osdi:TT_S02_DevA_Risk ,
                                         osdi:TT_S02_Disease ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "S02. Single development with risk. One development not affected by any rule: it either appears (0.3) or not." .


