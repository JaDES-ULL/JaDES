<https://w3id.org/ontologies-ULL//individuals/test> rdf:type owl:Ontology ;
                                                     owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.0> ;
                                                     rdfs:comment "Individuals for OSDi ontology, version 1.0"@en ;
                                                     rdfs:label "OSDi individuals for Testing"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#TEST_BaseAnnualTreatmentCost
osdi:TEST_BaseAnnualTreatmentCost rdf:type owl:NamedIndividual ,
                                           osdi:Cost ,
                                           osdi:DeterministicParameter ;
                                  osdi:hasDataItemType osdi:Currency_Euro ;
                                  osdi:includedByModel osdi:TEST_DecisionTreeModel1 ,
                                                       osdi:TEST_DecisionTreeModel2 ,
                                                       osdi:TEST_DecisionTreeModel3 ;
                                  osdi:appliesOneTime "false"^^xsd:boolean ;
                                  osdi:hasExpectedValue "1000.0"^^xsd:double ;
                                  osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_CoexistentDevelopment1
osdi:TEST_CoexistentDevelopment1 rdf:type owl:NamedIndividual ,
                                          osdi:Development ;
                                 osdi:hasCost osdi:TEST_SevereAnnualTreatmentCost ;
                                 osdi:hasEffect osdi:TEST_LifeExpectancyReduction ;
                                 osdi:hasRiskCharacterization osdi:TEST_SevereDevelopmentIncidence ;
                                 osdi:hasUtility osdi:TEST_SevereDevelopmentDisutility ;
                                 osdi:includedByModel osdi:TEST_DecisionTreeModel2 ,
                                                      osdi:TEST_DecisionTreeModel3 .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_CoexistentDevelopment2
osdi:TEST_CoexistentDevelopment2 rdf:type owl:NamedIndividual ,
                                          osdi:Development ;
                                 osdi:hasCost osdi:TEST_SevereAnnualTreatmentCost ;
                                 osdi:hasRiskCharacterization osdi:TEST_SevereDevelopmentIncidence ;
                                 osdi:hasUtility osdi:TEST_CoexistentDevelopment2Disutility ;
                                 osdi:includedByModel osdi:TEST_DecisionTreeModel2 ,
                                                      osdi:TEST_DecisionTreeModel3 .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_CoexistentDevelopment2Disutility
osdi:TEST_CoexistentDevelopment2Disutility rdf:type owl:NamedIndividual ,
                                                    osdi:DeterministicParameter ,
                                                    osdi:Utility ;
                                           osdi:hasDataItemType osdi:DI_Generic_Utility ;
                                           osdi:includedByModel osdi:TEST_DecisionTreeModel2 ,
                                                                osdi:TEST_DecisionTreeModel3 ;
                                           osdi:appliesOneTime "false"^^xsd:boolean ;
                                           osdi:hasExpectedValue "0.2"^^xsd:double ;
                                           osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_DecisionTreeModel1
osdi:TEST_DecisionTreeModel1 rdf:type owl:NamedIndividual ,
                                      osdi:DecisionTreeModel ;
                             osdi:includesModelItem osdi:TEST_BaseAnnualTreatmentCost ,
                                                    osdi:TEST_DevelopmentSet ,
                                                    osdi:TEST_Disease1 ,
                                                    osdi:TEST_InterventionEffective ,
                                                    osdi:TEST_InterventionEffectiveCost ,
                                                    osdi:TEST_InterventionEffectiveEffect ,
                                                    osdi:TEST_InterventionEffectiveEffectMagnitude ,
                                                    osdi:TEST_InterventionIneffective ,
                                                    osdi:TEST_LifeExpectancy ,
                                                    osdi:TEST_LifeExpectancyReduction ,
                                                    osdi:TEST_LifeExpectancyReductionMagnitude ,
                                                    osdi:TEST_NormalDevelopment ,
                                                    osdi:TEST_Population ,
                                                    osdi:TEST_PopulationAge ,
                                                    osdi:TEST_PopulationBaseUtility ,
                                                    osdi:TEST_PopulationSex ,
                                                    osdi:TEST_SevereAnnualTreatmentCost ,
                                                    osdi:TEST_SevereDevelopment ,
                                                    osdi:TEST_SevereDevelopmentDisutility ,
                                                    osdi:TEST_SevereDevelopmentIncidence ;
                             osdi:hasDescription "Test model 1. A tree that compares a 'do nothing' versus a fully effective intervention. The disease defines two alternative developments: one with severe symptoms (characterized by a lifetime reduction of 20 years and a disutility of 0.4) and a normal development, with no negative effects. The population is a dummy population." .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_DecisionTreeModel2
osdi:TEST_DecisionTreeModel2 rdf:type owl:NamedIndividual ,
                                      osdi:DecisionTreeModel ;
                             osdi:includesModelItem osdi:TEST_BaseAnnualTreatmentCost ,
                                                    osdi:TEST_CoexistentDevelopment1 ,
                                                    osdi:TEST_CoexistentDevelopment2 ,
                                                    osdi:TEST_CoexistentDevelopment2Disutility ,
                                                    osdi:TEST_Disease2 ,
                                                    osdi:TEST_InterventionEffective ,
                                                    osdi:TEST_InterventionEffectiveCost ,
                                                    osdi:TEST_InterventionEffectiveEffect ,
                                                    osdi:TEST_InterventionEffectiveEffectMagnitude ,
                                                    osdi:TEST_InterventionIneffective ,
                                                    osdi:TEST_LifeExpectancy ,
                                                    osdi:TEST_LifeExpectancyReduction ,
                                                    osdi:TEST_LifeExpectancyReductionMagnitude ,
                                                    osdi:TEST_Population ,
                                                    osdi:TEST_PopulationAge ,
                                                    osdi:TEST_PopulationBaseUtility ,
                                                    osdi:TEST_PopulationSex ,
                                                    osdi:TEST_SevereAnnualTreatmentCost ,
                                                    osdi:TEST_SevereDevelopmentDisutility ,
                                                    osdi:TEST_SevereDevelopmentIncidence ;
                             osdi:hasDescription "Test model 2. A tree that compares a 'do nothing' versus a fully effective intervention. The disease defines two coexistent developments: one with severe symptoms (characterized by a lifetime reduction of 20 years and a disutility of 0.4) and a development with no negative effects apart from a slight reduction on QOL. The population is a dummy population." .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_DecisionTreeModel3
osdi:TEST_DecisionTreeModel3 rdf:type owl:NamedIndividual ,
                                      osdi:DecisionTreeModel ;
                             osdi:includesModelItem osdi:TEST_BaseAnnualTreatmentCost ,
                                                    osdi:TEST_CoexistentDevelopment1 ,
                                                    osdi:TEST_CoexistentDevelopment2 ,
                                                    osdi:TEST_CoexistentDevelopment2Disutility ,
                                                    osdi:TEST_DevelopmentSet ,
                                                    osdi:TEST_Disease3 ,
                                                    osdi:TEST_InterventionEffective ,
                                                    osdi:TEST_InterventionEffectiveCost ,
                                                    osdi:TEST_InterventionEffectiveEffect ,
                                                    osdi:TEST_InterventionEffectiveEffectMagnitude ,
                                                    osdi:TEST_InterventionIneffective ,
                                                    osdi:TEST_LifeExpectancy ,
                                                    osdi:TEST_LifeExpectancyReduction ,
                                                    osdi:TEST_LifeExpectancyReductionMagnitude ,
                                                    osdi:TEST_NormalDevelopment ,
                                                    osdi:TEST_Population ,
                                                    osdi:TEST_PopulationAge ,
                                                    osdi:TEST_PopulationBaseUtility ,
                                                    osdi:TEST_PopulationSex ,
                                                    osdi:TEST_SevereAnnualTreatmentCost ,
                                                    osdi:TEST_SevereDevelopment ,
                                                    osdi:TEST_SevereDevelopmentDisutility ,
                                                    osdi:TEST_SevereDevelopmentIncidence ;
                             osdi:hasDescription "Test model 3. A tree that compares a 'do nothing' versus a fully effective intervention. The disease defines two coexistent developments: one with severe symptoms (characterized by a lifetime reduction of 20 years and a disutility of 0.4) and a development with no negative effects apart from a slight reduction on QOL; and two alternative developments: one with severe symptoms (characterized by a lifetime reduction of 20 years and a disutility of 0.4) and a normal development, with no negative effects. The population is a dummy population." .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_DevelopmentSet
osdi:TEST_DevelopmentSet rdf:type owl:NamedIndividual ,
                                  osdi:AlternativeCombinationRule ;
                         osdi:affectsProgressionElement osdi:TEST_NormalDevelopment ,
                                                        osdi:TEST_SevereDevelopment ;
                         osdi:includedByModel osdi:TEST_DecisionTreeModel1 ,
                                              osdi:TEST_DecisionTreeModel3 ;
                         osdi:hasNullProgression "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_Disease1
osdi:TEST_Disease1 rdf:type owl:NamedIndividual ,
                            osdi:Disease ;
                   osdi:hasCost osdi:TEST_BaseAnnualTreatmentCost ;
                   osdi:hasIntervention osdi:InterventionDoNothing ,
                                        osdi:TEST_InterventionEffective ;
                   osdi:hasProgressionElement osdi:TEST_DevelopmentSet ,
                                              osdi:TEST_NormalDevelopment ,
                                              osdi:TEST_SevereDevelopment ;
                   osdi:includedByModel osdi:TEST_DecisionTreeModel1 .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_Disease2
osdi:TEST_Disease2 rdf:type owl:NamedIndividual ,
                            osdi:Disease ;
                   osdi:hasCost osdi:TEST_BaseAnnualTreatmentCost ;
                   osdi:hasIntervention osdi:InterventionDoNothing ,
                                        osdi:TEST_InterventionEffective ;
                   osdi:hasProgressionElement osdi:TEST_CoexistentDevelopment1 ,
                                              osdi:TEST_CoexistentDevelopment2 ;
                   osdi:includedByModel osdi:TEST_DecisionTreeModel2 .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_Disease3
osdi:TEST_Disease3 rdf:type owl:NamedIndividual ,
                            osdi:Disease ;
                   osdi:hasCost osdi:TEST_BaseAnnualTreatmentCost ;
                   osdi:hasIntervention osdi:InterventionDoNothing ,
                                        osdi:TEST_InterventionEffective ;
                   osdi:hasProgressionElement osdi:TEST_CoexistentDevelopment1 ,
                                              osdi:TEST_CoexistentDevelopment2 ,
                                              osdi:TEST_DevelopmentSet ,
                                              osdi:TEST_NormalDevelopment ,
                                              osdi:TEST_SevereDevelopment ;
                   osdi:includedByModel osdi:TEST_DecisionTreeModel3 .


###  https://w3id.org/ontologies-ULL/OSDi#TEST_InterventionEffective
osdi:TEST_InterventionEffective rdf:type owl:NamedIndividual ,
                                         osdi:TherapeuticIntervention ;
                                osdi:hasCost osdi:TEST_InterventionEffectiveCost ;
                                osdi:hasEffect osdi:TEST_InterventionEffectiveEffect ;
                                osdi:includedByModel osdi:TEST_DecisionTreeModel1 ,
                                                     osdi:TEST_DecisionTreeModel2 ,
                                                     osdi:TEST_DecisionTreeModel3 ;
                                osdi:isAssessedIntervention "true"^^xsd:boolean .


