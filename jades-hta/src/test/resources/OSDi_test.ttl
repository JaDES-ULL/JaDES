###  https://w3id.org/ontologies-ULL/OSDi#TEST_Population
osdi:TEST_Population rdf:type owl:NamedIndividual ,
                              osdi:Population ;
                     osdi:hasAge osdi:TEST_PopulationAge ;
                     osdi:hasEpidemiologicalParameter osdi:Constant_Prevalence1 ;
                     osdi:hasLifeExpectancy osdi:TEST_LifeExpectancy ;
                     osdi:hasSex osdi:TEST_PopulationSex ;
                     osdi:hasUtility osdi:TEST_PopulationBaseUtility ;
                     osdi:includedByModel osdi:TEST_DecisionTreeModel1 ,
                                          osdi:TEST_DecisionTreeModel2 ,
                                          osdi:TEST_DecisionTreeModel3 ;
                     osdi:hasDescription "A dummy population of 1000 individuals infected by a disease. Every one starts at 20 years old, with a life expectancy of 85 years and an expected utility of 0.85" ;
                     osdi:hasGeographicalContext "Spain" ;
                     osdi:hasMaxAge "100.0"^^xsd:double ;
                     osdi:hasMinAge "18.0"^^xsd:double ;
                     osdi:hasSize 1000 .


