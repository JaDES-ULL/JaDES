                            osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevB_LER
osdi:TT_N01_DevB_LER rdf:type owl:NamedIndividual ,
                              osdi:LifeExpectancyReductionEffect ;
                     osdi:affects osdi:Attribute_LifeExpectancy ;
                     osdi:hasEffectMagnitude osdi:TT_N01_DevB_LERMagnitude ;
