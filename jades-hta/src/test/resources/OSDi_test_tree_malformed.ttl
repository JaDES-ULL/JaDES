                      osdi:hasDataItemType osdi:Currency_Euro ;
                      osdi:includedByModel osdi:TT_N01_Model ;
                      osdi:appliesOneTime "false"^^xsd:boolean ;
                      osdi:hasDescription "Annual cost of DevB" ;
                      osdi:hasExpectedValue "300.0"^^xsd:double ;
                      osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevB_Disutility
osdi:TT_N01_DevB_Disutility rdf:type owl:NamedIndividual ,
