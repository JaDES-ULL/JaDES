    osdi:usesModel osdi:TT_N36_Model ;
    osdi:hasDescription "Acute manifestation with a frequency and an effect on the life expectancy (not supported: the effects are not multiplied by the episodes)." ;
    osdi:hasDiscountForCosts "0.0"^^xsd:double ;
    osdi:hasDiscountForEffects "0.0"^^xsd:double ;
    osdi:hasDisutilityCombinationMethod "ADD" ;
    osdi:hasTimeHorizon "5.0"^^xsd:double ;
    osdi:hasYear "2026"^^xsd:short .


