@prefix : <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix osdi: <https://w3id.org/ontologies-ULL/OSDi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-malformed> .

<https://w3id.org/ontologies-ULL/OSDi/individuals/test-tree-malformed> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/OSDi/1.1> ;
    rdfs:comment "Individuals for OSDi ontology, version 1.1. Models that must be rejected when generating a decision tree."@en ;
    rdfs:label "OSDi individuals for testing decision trees: malformed or unsupported models"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/OSDi#TT_BaseAnnualCost
osdi:TT_BaseAnnualCost rdf:type owl:NamedIndividual ,
                                osdi:Cost ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:Currency_Euro ;
                       osdi:includedByModel osdi:TT_N01_Model ,
                                            osdi:TT_N02_Model ,
                                            osdi:TT_N03_Model ,
                                            osdi:TT_N04_Model ,
                                            osdi:TT_N05_Model ,
                                            osdi:TT_N06_Model ;
                       osdi:appliesOneTime "false"^^xsd:boolean ;
                       osdi:hasDescription "Annual cost of the disease, whatever its progression" ;
                       osdi:hasExpectedValue "1000.0"^^xsd:double ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionNone
osdi:TT_InterventionNone rdf:type owl:NamedIndividual ,
                                  osdi:TherapeuticIntervention ;
                         osdi:includedByModel osdi:TT_N01_Model ,
                                              osdi:TT_N02_Model ,
                                              osdi:TT_N03_Model ,
                                              osdi:TT_N04_Model ,
                                              osdi:TT_N05_Model ,
                                              osdi:TT_N06_Model ;
                         osdi:hasDescription "Comparator: do nothing" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_InterventionTreat
osdi:TT_InterventionTreat rdf:type owl:NamedIndividual ,
                                   osdi:TherapeuticIntervention ;
                          osdi:hasCost osdi:TT_TreatAnnualCost ;
                          osdi:includedByModel osdi:TT_N01_Model ,
                                               osdi:TT_N02_Model ,
                                               osdi:TT_N03_Model ,
                                               osdi:TT_N04_Model ,
                                               osdi:TT_N05_Model ,
                                               osdi:TT_N06_Model ;
                          osdi:hasDescription "Assessed intervention: it only adds an annual cost of 100" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_LifeExpectancy
osdi:TT_LifeExpectancy rdf:type owl:NamedIndividual ,
                                osdi:AttributeValueParameter ,
                                osdi:DeterministicParameter ;
                       osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                       osdi:includedByModel osdi:TT_N01_Model ,
                                            osdi:TT_N02_Model ,
                                            osdi:TT_N03_Model ,
                                            osdi:TT_N04_Model ,
                                            osdi:TT_N06_Model ;
                       osdi:isValueOfAttribute osdi:Attribute_LifeExpectancy ;
                       osdi:hasExpectedValue "65.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_AlternativeDevs
osdi:TT_N01_AlternativeDevs rdf:type owl:NamedIndividual ,
                                     osdi:AlternativeCombinationRule ;
                            osdi:affectsProgressionElement osdi:TT_N01_DevA ,
                                                           osdi:TT_N01_DevB ;
                            osdi:includedByModel osdi:TT_N01_Model ;
                            osdi:hasNullProgression "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevA
osdi:TT_N01_DevA rdf:type owl:NamedIndividual ,
                          osdi:Development ;
                 osdi:hasCost osdi:TT_N01_DevA_Cost ;
                 osdi:hasEffect osdi:TT_N01_DevA_LER ;
                 osdi:hasUtility osdi:TT_N01_DevA_Disutility ;
                 osdi:includedByModel osdi:TT_N01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevA_Cost
osdi:TT_N01_DevA_Cost rdf:type owl:NamedIndividual ,
                               osdi:Cost ,
                               osdi:DeterministicParameter ;
                      osdi:hasDataItemType osdi:Currency_Euro ;
                      osdi:includedByModel osdi:TT_N01_Model ;
                      osdi:appliesOneTime "false"^^xsd:boolean ;
                      osdi:hasDescription "Annual cost of DevA" ;
                      osdi:hasExpectedValue "500.0"^^xsd:double ;
                      osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevA_Disutility
osdi:TT_N01_DevA_Disutility rdf:type owl:NamedIndividual ,
                                     osdi:DeterministicParameter ,
                                     osdi:Utility ;
                            osdi:hasDataItemType osdi:DI_Generic_Utility ;
                            osdi:includedByModel osdi:TT_N01_Model ;
                            osdi:appliesOneTime "false"^^xsd:boolean ;
                            osdi:hasDescription "Annual disutility of DevA" ;
                            osdi:hasExpectedValue "0.1"^^xsd:double ;
                            osdi:isDisutility "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevA_LER
osdi:TT_N01_DevA_LER rdf:type owl:NamedIndividual ,
                              osdi:LifeExpectancyReductionEffect ;
                     osdi:affects osdi:Attribute_LifeExpectancy ;
                     osdi:hasEffectMagnitude osdi:TT_N01_DevA_LERMagnitude ;
                     osdi:includedByModel osdi:TT_N01_Model ;
                     osdi:hasDescription "Life expectancy reduction due to DevA" .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevA_LERMagnitude
osdi:TT_N01_DevA_LERMagnitude rdf:type owl:NamedIndividual ,
                                       osdi:DeterministicParameter ;
                              osdi:hasDataItemType osdi:DI_Continuous_Variable ;
                              osdi:includedByModel osdi:TT_N01_Model ;
                              osdi:hasDescription "Years of life lost due to DevA" ;
                              osdi:hasExpectedValue "10.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_DevB
osdi:TT_N01_DevB rdf:type owl:NamedIndividual ,
                          osdi:Development ;
                 osdi:hasCost osdi:TT_N01_DevB_Cost ;
                 osdi:hasEffect osdi:TT_N01_DevB_LER ;
                 osdi:hasUtility osdi:TT_N01_DevB_Disutility ;
                 osdi:includedByModel osdi:TT_N01_Model .


