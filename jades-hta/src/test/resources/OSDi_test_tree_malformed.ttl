                              osdi:includedByModel osdi:TT_N01_Model ;
                              osdi:hasDescription "Years of life lost due to DevB" ;
                              osdi:hasExpectedValue "4.0"^^xsd:double .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_Disease
osdi:TT_N01_Disease rdf:type owl:NamedIndividual ,
                             osdi:Disease ;
                    osdi:hasCost osdi:TT_BaseAnnualCost ;
                    osdi:hasIntervention osdi:TT_InterventionTreat ,
                                         osdi:TT_InterventionNone ;
                    osdi:hasProgressionElement osdi:TT_N01_DevA ,
                                               osdi:TT_N01_DevB ,
                                               osdi:TT_N01_AlternativeDevs ;
                    osdi:includedByModel osdi:TT_N01_Model .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_Experiment
osdi:TT_N01_Experiment rdf:type owl:NamedIndividual ,
                                osdi:Experiment ;
                       osdi:usesModel osdi:TT_N01_Model ;
                       osdi:hasDescription "Alternative developments: two of them without risk." ;
                       osdi:hasDiscountForCosts "0.0"^^xsd:double ;
                       osdi:hasDiscountForEffects "0.0"^^xsd:double ;
                       osdi:hasDisutilityCombinationMethod "ADD" ;
                       osdi:hasYear "2026"^^xsd:short .


###  https://w3id.org/ontologies-ULL/OSDi#TT_N01_Model
osdi:TT_N01_Model rdf:type owl:NamedIndividual ,
                           osdi:DecisionTreeModel ;
                  osdi:hasAssessedIntervention osdi:TT_InterventionTreat ;
                  osdi:hasComparatorIntervention osdi:TT_InterventionNone ;
                  osdi:includesModelItem osdi:TT_BaseAnnualCost ,
                                         osdi:TT_InterventionNone ,
                                         osdi:TT_InterventionTreat ,
                                         osdi:TT_LifeExpectancy ,
                                         osdi:TT_N01_AlternativeDevs ,
                                         osdi:TT_N01_DevA ,
                                         osdi:TT_N01_DevA_Cost ,
                                         osdi:TT_N01_DevA_Disutility ,
                                         osdi:TT_N01_DevA_LER ,
                                         osdi:TT_N01_DevA_LERMagnitude ,
                                         osdi:TT_N01_DevB ,
                                         osdi:TT_N01_DevB_Cost ,
                                         osdi:TT_N01_DevB_Disutility ,
                                         osdi:TT_N01_DevB_LER ,
                                         osdi:TT_N01_DevB_LERMagnitude ,
                                         osdi:TT_N01_Disease ,
                                         osdi:TT_Population ,
                                         osdi:TT_PopulationAge ,
                                         osdi:TT_PopulationBaseUtility ,
                                         osdi:TT_PopulationSex ,
                                         osdi:TT_TreatAnnualCost ;
                  osdi:hasDescription "N01. Alternative developments: two of them without risk. Only one development of an alternative set can lack a risk (it takes the remaining probability)." .


